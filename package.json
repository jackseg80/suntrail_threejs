{
    "name": "suntrail_threejs",
    "version": "5.88.0",
    "scripts": {
        "dev": "vite",
        "check": "tsc --noEmit && prettier --check src/ && eslint src/",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix",
        "format": "prettier --write src/",
        "format:check": "prettier --check src/",
        "build": "vite build",
        "build:capacitor": "cross-env CAPACITOR=true npm run build",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:smoke": "playwright test --project=chromium --workers=1 --grep @smoke --reporter=line",
        "test:e2e:full": "playwright test --workers=1",
        "test:e2e:ui": "playwright test --ui",
        "check:bundle": "node scripts/check-bundle-budget.mjs",
        "check:capacitor-assets": "node scripts/check-capacitor-assets.mjs",
        "cap:sync": "npm run build:capacitor && npm run check:capacitor-assets && npx cap sync",
        "cap:open": "npx cap open android",
        "cap:assets": "npx capacitor-assets generate --android",
        "deploy": "npm run check && npm run cap:sync",
        "android:update": "npm run deploy",
        "build-overview": "npx tsx scripts/build-overview-tiles.ts",
        "build-pack": "npx tsx scripts/build-country-pack.ts",
        "audit:i18n": "python scripts/audit_i18n.py"
    },
    "dependencies": {
        "@capacitor/android": "^8.2.0",
        "@capacitor/app": "^8.0.1",
        "@capacitor/browser": "^8.0.3",
        "@capacitor/core": "^8.2.0",
        "@capacitor/filesystem": "^8.1.2",
        "@capacitor/geolocation": "^8.1.0",
        "@capacitor/haptics": "^8.0.1",
        "@capacitor/network": "^8.0.1",
        "@capacitor/preferences": "^8.0.1",
        "@mapbox/vector-tile": "^3.0.0",
        "@revenuecat/purchases-capacitor": "^13.2.0",
        "@revenuecat/purchases-js": "^1.43.0",
        "@supabase/supabase-js": "^2.105.3",
        "gpxparser": "^3.0.8",
        "pbf": "^5.1.0",
        "pmtiles": "^4.4.0",
        "suncalc": "^2.0.0",
        "three": "^0.184.0"
    },
    "devDependencies": {
        "@aws-sdk/client-s3": "^3.1023.0",
        "@aws-sdk/lib-storage": "^3.1023.0",
        "@capacitor/assets": "^3.0.5",
        "@capacitor/cli": "^8.3.0",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.62.1",
        "@testing-library/dom": "^10.4.1",
        "@types/node": "^25.4.0",
        "@types/three": "^0.184.0",
        "@typescript-eslint/eslint-plugin": "^8.60.0",
        "@typescript-eslint/parser": "^8.60.0",
        "@vitest/coverage-v8": "^4.1.10",
        "@vitest/ui": "^4.1.10",
        "axe-core": "^4.11.1",
        "cross-env": "^10.1.0",
        "dotenv": "^17.4.0",
        "esbuild": "^0.28.1",
        "eslint": "^10.4.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-unicorn": "^64.0.0",
        "fake-indexeddb": "^6.2.4",
        "globals": "^17.6.0",
        "happy-dom": "^20.11.1",
        "prettier": "^3.8.3",
        "sharp": "^0.35.3",
        "typescript": "^6.0.3",
        "vite": "^8.2.0",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^4.1.10"
    },
    "overrides": {
        "sharp": "$sharp",
        "vite": "$vite",
        "nanoid": "^3.3.17",
        "jsdom": "^25.0.1",
        "qs": "^6.14.1",
        "tough-cookie": "^4.1.3",
        "@xmldom/xmldom": "^0.8.12",
        "tar": "^7.5.11",
        "minimatch": "^3.1.4",
        "serialize-javascript": "^7.0.5",
        "uuid": "^11.1.0"
    }
}
