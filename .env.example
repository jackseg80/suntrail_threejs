# Copier ce fichier en .env et remplir les clés
# MapTiler : https://cloud.maptiler.com → Dashboard → API Keys
VITE_MAPTILER_KEY=your_maptiler_key_here

# RevenueCat Android : https://app.revenuecat.com → Project → API Keys
# test_ pour sandbox, goog_ pour production
VITE_REVENUECAT_KEY=your_revenuecat_key_here

# RevenueCat Web (Stripe) : https://app.revenuecat.com → Project → API Keys → Web
# rc_web_ pour production (lier un compte Stripe au préalable dans les Integrations RC)
VITE_REVENUECAT_WEB_KEY=your_revenuecat_web_key_here

# Catalogue de packs et flags de release distants (optionnels)
VITE_PACKS_CATALOG_URL=https://example.com/catalog.json
VITE_RELEASE_FLAGS_URL=https://example.com/release-flags.json

# Supabase : infrastructure de compte/synchronisation actuellement désactivée
# Ces valeurs ne sont pas nécessaires au fonctionnement local de la v5.88.
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
