<?xml version="1.0" encoding="utf-8"?>
<!--
    Règles de sauvegarde Android 11 et antérieur.
    - Aucune donnée n'est envoyée dans Auto Backup / Google Drive.
    - Les données applicatives sont autorisées uniquement pour le transfert
      direct appareil-à-appareil, qui préserve l'historique GPX local.
    - Les SharedPreferences ne figurent pas dans les inclusions et restent donc exclues.
    Référence : https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <include domain="root" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="file" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="database" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="external" path="." requireFlags="deviceToDeviceTransfer" />
</full-backup-content>
