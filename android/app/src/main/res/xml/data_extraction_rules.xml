<?xml version="1.0" encoding="utf-8"?>
<!--
    Règles d'extraction de données Android 12+ (API 31+).
    Les traces GPS, l'historique WebView et les clés saisies par l'utilisateur
    ne doivent jamais être envoyés vers le cloud. Le transfert local
    appareil-à-appareil reste autorisé pour préserver l'historique.
    Référence : https://developer.android.com/about/versions/12/backup-restore
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Les préférences peuvent contenir des clés API saisies manuellement. -->
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
